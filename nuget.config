<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- WHY: <clear /> + packageSourceMapping protects against a "dependency confusion" attack: a ShopFlow.* package may
       come only from the internal feed, and everything else only from nuget.org. Without the mapping NuGet takes the
       highest version from any source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- GitHub Packages feed for the ShopFlow.Contracts package published by
         .github/workflows/contracts-publish.yml. Inside the monorepo services use ProjectReference;
         the feed is needed by consumers outside the repository.
    <add key="shopflow" value="https://nuget.pkg.github.com/shopflow-org/index.json" />
    -->
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
