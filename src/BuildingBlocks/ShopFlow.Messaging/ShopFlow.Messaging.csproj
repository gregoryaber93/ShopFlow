<Project Sdk="Microsoft.NET.Sdk">

  <!-- WHY: messaging abstractions with no dependency on a specific broker. Application projects reference
       only this project, so business logic can be tested without the Service Bus SDK, and the broker
       adapter (ShopFlow.Messaging.ServiceBus) is a replaceable detail. -->
  <PropertyGroup>
    <RootNamespace>ShopFlow.Messaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopFlow.Contracts\ShopFlow.Contracts.csproj" />
    <ProjectReference Include="..\ShopFlow.SharedKernel\ShopFlow.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShopFlow.BuildingBlocks.Tests" />
  </ItemGroup>

</Project>
