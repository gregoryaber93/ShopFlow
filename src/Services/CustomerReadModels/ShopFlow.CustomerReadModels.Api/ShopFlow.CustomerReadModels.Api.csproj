<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ShopFlow.CustomerReadModels.Api</RootNamespace>
    <!-- AZURE: the "chiseled" image has no ICU; the API returns data in a culture-independent format
         (ISO 8601 dates, amounts as numbers), and human-friendly formatting is done by the client application. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopFlow.CustomerReadModels.Infrastructure\ShopFlow.CustomerReadModels.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\ShopFlow.Web\ShopFlow.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

</Project>
