{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Aggregator": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api"
    },
    "serviceBus": {
      "autoCompleteMessages": false,
      "prefetchCount": 0,
      "maxConcurrentCalls": 16,
      "maxConcurrentSessions": 32,
      "sessionIdleTimeout": "00:00:05",
      "maxAutoLockRenewalDuration": "00:05:00",
      "clientRetryOptions": {
        "mode": "Exponential",
        "tryTimeout": "00:01:00",
        "delay": "00:00:00.80",
        "maxDelay": "00:00:30",
        "maxRetries": 5
      }
    }
  }
}
