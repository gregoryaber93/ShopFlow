<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ShopFlow.Inventory.Api</RootNamespace>
    <!-- AZURE: the "chiseled" base image does not contain the ICU libraries (localization, culture collations). Invariant
         mode is a prerequisite for running the application in it; number and date formatting in the API is culture-invariant anyway. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopFlow.Inventory.Infrastructure\ShopFlow.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\ShopFlow.Web\ShopFlow.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

</Project>
