<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ShopFlow.Notifications.Functions</RootNamespace>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <!-- WHY: unlike the other function apps. Notifications formats amounts and dates according to the customer's culture
         (pl-PL, en-GB), which requires ICU data. In InvariantGlobalization mode calling
         CultureInfo.GetCultureInfo("pl-PL") throws. The Flex Consumption Linux image has the ICU library. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShopFlow.Notifications.Infrastructure\ShopFlow.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\ShopFlow.Functions\ShopFlow.Functions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="local.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
