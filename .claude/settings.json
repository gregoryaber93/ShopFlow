{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "PACT_DO_NOT_TRACK": "true"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet restore:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet ef migrations has-pending-model-changes:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(node scripts/check-english.mjs:*)",
      "Bash(node scripts/check-links.mjs:*)",
      "Bash(./scripts/verify.sh:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(az login:*)",
      "Bash(az deployment:*)",
      "Bash(azd up:*)",
      "Bash(docker push:*)",
      "Bash(dotnet nuget push:*)",
      "Read(./**/local.settings.json)",
      "Read(./**/appsettings.Local.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-cloud-commands.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-generated-files.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-english.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
