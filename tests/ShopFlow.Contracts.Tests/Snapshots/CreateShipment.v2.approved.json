{
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "orderNumber": {
      "type": "string"
    },
    "shipmentId": {
      "type": "string",
      "format": "uuid"
    },
    "warehouseCode": {
      "type": "string"
    },
    "destination": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "courier",
            "pickupPoint"
          ]
        },
        "address": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "recipientName": {
              "type": "string"
            },
            "line1": {
              "type": "string"
            },
            "line2": {
              "type": [
                "string",
                "null"
              ]
            },
            "city": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "countryCode": {
              "type": "string"
            },
            "phone": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "recipientName",
            "line1",
            "city",
            "postalCode",
            "countryCode"
          ]
        },
        "pickupPointId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": [
              "string",
              "integer"
            ],
            "pattern": "^-?(?:0|[1-9]\\d*)$"
          }
        },
        "required": [
          "sku",
          "quantity"
        ]
      }
    }
  },
  "required": [
    "orderId",
    "customerId",
    "orderNumber",
    "shipmentId",
    "warehouseCode",
    "destination",
    "lines"
  ]
}
