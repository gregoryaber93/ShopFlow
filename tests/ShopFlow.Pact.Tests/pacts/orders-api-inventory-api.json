{
  "consumer": {
    "name": "orders-api"
  },
  "interactions": [
    {
      "description": "a request for the checkout price of one SKU",
      "pending": false,
      "providerStates": [
        {
          "name": "SKU-1 costs 19.99 PLN and is available"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/internal/catalog/prices",
        "query": {
          "sku": [
            "SKU-1"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "items": [
              {
                "isAvailable": true,
                "productName": "Kubek",
                "sku": "SKU-1",
                "unitPrice": {
                  "amount": 19.99,
                  "currency": "PLN"
                }
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*].isAvailable": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].productName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].unitPrice.amount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.items[*].unitPrice.currency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^[A-Z]{3}$"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*$"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "inventory-api"
  }
}