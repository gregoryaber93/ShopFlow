<Project>

  <!-- WHY: Central Package Management. In a monorepo with dozens of projects, versions set per project end up with
       two services using different Azure SDK versions and behaving differently on the same error. This is the single
       source of truth, and Dependabot updates one file. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Version groups">
    <!-- WHY: we keep the Microsoft.Extensions.*, ASP.NET Core and EF Core packages on the 10.x line,
         matching the target runtime (.NET 10 LTS). The 11.x line requires .NET 11. -->
    <DotNetExtensionsVersion>10.0.15</DotNetExtensionsVersion>
    <DotNetPlatformExtensionsVersion>10.11.0</DotNetPlatformExtensionsVersion>
    <OpenTelemetryVersion>1.21.0</OpenTelemetryVersion>
  </PropertyGroup>

  <ItemGroup Label="Azure SDK">
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="Azure.Communication.Sms" Version="1.0.2" />
    <PackageVersion Include="Azure.Core" Version="1.65.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Messaging.EventHubs" Version="5.12.2" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.2" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.64.0" />
    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.6.1" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />
    <!-- AZURE: a StackExchange.Redis extension for Entra ID authentication: it acquires a token and renews it before
         it expires on open connections (the token lives about an hour). -->
    <PackageVersion Include="Microsoft.Azure.StackExchangeRedis" Version="3.3.1" />
    <!-- AZURE: Microsoft.Azure.Cosmos requires an explicit reference to Newtonsoft.Json in the application (a target in
         the package checks it), even when documents are serialized with System.Text.Json. The SDK uses Newtonsoft
         internally, and the explicit reference forces a patched version. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup Label="Azure Functions (isolated worker)">
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.CosmosDB" Version="4.16.1" />
    <!-- Durable Functions (isolated) and the Durable Task Scheduler backend. The Microsoft.DurableTask.* packages
         (orchestration abstractions, client) come in transitively in a version compatible with the extension;
         pinning them separately would risk binary incompatibility with the extension. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask.AzureManaged" Version="1.12.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.EventHubs" Version="6.5.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.OpenTelemetry" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Label="Data access">
    <!-- AZURE: Microsoft.Data.SqlClient is deliberately not pinned here. EF Core 10 brings it in transitively in
         version 6.1.x, which has Entra ID authentication (Authentication=Active Directory Managed Identity) built in.
         Since version 7.0 Entra ID support moved to the separate Microsoft.Data.SqlClient.Extensions.Azure package.
         Bumping SqlClient to 7.x without that package compiles fine but fails in Azure when opening a connection. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DotNetExtensionsVersion)" />
    <!-- Design-time tools (dotnet ef migrations add / bundle); they do not reach the runtime. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(DotNetExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup Label=".NET extensions">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="$(DotNetPlatformExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(DotNetExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="$(DotNetPlatformExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>

  <ItemGroup Label="Application libraries">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Polly.Core" Version="8.9.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- Dependency rules between types and namespaces (architecture tests). -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- AZURE/WHY: PactNet runs locally (the native pact_ffi library ships in the package), and pacts are JSON files in the
         repository. A Pact Broker (PactFlow or self-hosted) would be needed only with many repositories. -->
    <PackageVersion Include="PactNet" Version="5.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- Integration tests with the Cosmos DB emulator in Docker. Run only with the
         SHOPFLOW_RUN_INTEGRATION_TESTS=1 variable; skipped by default (they need neither Docker nor an Azure account). -->
    <PackageVersion Include="Testcontainers.CosmosDb" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <!-- WHY: no Verify library. Since version 3x it requires a licence declaration (sponsorship or a granted
         exception) in an MSBuild property, otherwise the build fails with SC021. For JSON schema snapshots a text
         comparison with a file is enough (tests/ShopFlow.Contracts.Tests/SchemaSnapshot.cs). -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
