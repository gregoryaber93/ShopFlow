<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShopFlow.DlqReplay</RootNamespace>
    <AssemblyName>shopflow-dlq</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\ShopFlow.Contracts\ShopFlow.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same topology Bicep creates the entities from: the tool uses it to know where to replay a message. -->
    <EmbeddedResource Include="..\..\infra\modules\messaging\messaging-topology.json" LogicalName="messaging-topology.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShopFlow.DlqReplay.Tests" />
  </ItemGroup>

</Project>
