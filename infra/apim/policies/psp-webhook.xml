<!--
  Payment provider webhook → the psp-webhook function (Payments).
  WHY: unlike the carrier, the HMAC signature is verified by the function (PspWebhookVerifier): the signature covers the
  body and a timestamp, so it must be checked against exactly the bytes that arrived. The gateway restricts the source
  (PSP addresses) and authenticates to the function with its identity; the signature headers pass through unchanged.
-->
<policies>
  <inbound>
    <base />
    <ip-filter action="allow">
      <address-range from="{{psp-ip-from}}" to="{{psp-ip-to}}" />
    </ip-filter>
    <!-- The PSP sends no Authorization header (the signature is in a separate header), so the gateway sets it with its own token. -->
    <authentication-managed-identity resource="api://{{payments-function-client-id}}" client-id="{{apim-identity-client-id}}" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
