<!--
  Carrier webhook → the carrier-webhook function (Shipping).
  WHY: partner authentication at the gateway. The carrier sends a fixed token (Authorization: Bearer ...) whose value
  lives in Key Vault as a named value. The gateway checks it, removes it and forwards the request with an Entra ID token
  of its own identity. The function does not know the carrier's secret, and rotating the secret needs no service deployment.
-->
<policies>
  <inbound>
    <base />
    <ip-filter action="allow">
      <address-range from="{{carrier-ip-from}}" to="{{carrier-ip-to}}" />
    </ip-filter>
    <check-header name="Authorization" failed-check-httpcode="401" failed-check-error-message="Unauthorized" ignore-case="false">
      <value>Bearer {{carrier-webhook-token}}</value>
    </check-header>
    <set-header name="Authorization" exists-action="delete" />
    <authentication-managed-identity resource="api://{{shipping-function-client-id}}" client-id="{{apim-identity-client-id}}" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
